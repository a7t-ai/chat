# --- a7t-chat env (copy to .env and fill values) ---

# App
PORT=8787
BIND_HOST=127.0.0.1          # host: loopback only. Container overrides to 0.0.0.0 (published on 127.0.0.1).
DATA_DIR=./data
DB_PATH=./data/chat.db
RATE_LIMIT_PER_MIN=20        # per-key request rate limit for guests (0 = unlimited; admins get 6x)

# --- Auth / owner (#191) ---
# Everyone authenticates with a passkey (#169). There is NO blanket tailnet auto-admin: the old
# TRUST_TAILSCALE_HEADER path was REMOVED. Admin ("owner") is designated at SIGN-UP, not by config: the
# FIRST passkey account created via the PRIVATE (non-edge) path becomes the single owner (its row is
# stored role='admin'). A sign-up that arrives via the public edge (cloudflared) is NEVER the owner —
# even if it's the very first account — so a public visitor can't steal ownership before you sign up on
# the tailnet, and a later self-service sign-up can never self-promote. Nothing to set here: just make
# the owner's FIRST sign-up over Tailscale/loopback.
#
# DEV_ADMIN_LOGIN — LOCAL-only break-glass bootstrap AND owner recovery. When set, a request that did
# NOT arrive via the public edge is admitted as admin (login-keyed), so a fresh instance can be operated
# before the owner has signed up, and — critically — the owner can get back in if they LOSE their
# passkey (the stored owner row persists; use this to recover). NEVER honored via the edge. Leave EMPTY
# in production once the owner has signed up.
DEV_ADMIN_LOGIN=
# Edge discriminator (advanced, optional). cf-connecting-ip already marks public-edge requests; set
# these only if fronting with a different proxy that must be treated as the public edge. When
# EDGE_MARKER_SECRET is non-empty, a request carrying EDGE_MARKER_HEADER == the secret is treated as
# public-edge (never admin). Empty secret = only cf-connecting-ip marks the edge.
EDGE_MARKER_HEADER=x-a7t-edge
EDGE_MARKER_SECRET=

# Free tier — bounds for passkey ACCOUNT users (#169: email OTP + invites were removed; a passkey
# sign-up IS the account). Account users get NORMAL rate (RATE_LIMIT_PER_MIN) + the limits below;
# they are NEVER treated as admin. All optional.
FREE_TIER_MODELS=                 # comma-separated model ids account users may use (empty = just DEFAULT_MODEL)
FREE_TIER_TOKEN_BUDGET=200000     # total token budget per account user (0 = unlimited; summed from usage_events)
FREE_TIER_MAX_CONCURRENCY=1       # in-flight generations per account user

# Sessions (optional). SESSION_TTL_DAYS is the cookie/session lifetime; MAX_USER_AGENT_LENGTH caps the
# stored UA string. Both have safe defaults (30 days / 512 chars) — only set to override.
SESSION_TTL_DAYS=30
MAX_USER_AGENT_LENGTH=512

# Backends — host services. Native dev uses 127.0.0.1; the container uses host.docker.internal (see compose.yml).
JANO_URL=http://127.0.0.1:8082    # existing Jano router (coder/chat swap). Chat is a CLIENT; no second Jano.
EMBED_URL=http://127.0.0.1:8083   # embedding service (the workstation stead: llama-server --embedding, BGE-M3). Off Jano.
WHISPER_URL=http://127.0.0.1:8084 # whisper transcription service (OpenAI-compatible) for BATCH voice input
DEFAULT_MODEL=qwen-chat           # default model id (must match what Jano exposes via /v1/models)

# Live dictation / streaming STT (#71) — the "text streams into the composer AS YOU SPEAK" path,
# distinct from and ALONGSIDE the batch WHISPER_URL transcribe above (which stays the untouched
# fallback). DARK by default: leave STREAMING_STT_URL BLANK and the feature stays off — /api/me
# reports it unavailable, /api/dictate returns 503, and the composer shows only the batch mic.
# Set it to a streaming ASR service AFTER validating a streaming model (NVIDIA Nemotron-3.5-ASR is
# the candidate under separate validation; a thin Whisper-streaming shim also works). The app is
# backend-agnostic: it POSTs audio to this URL and reads back partial/final events (SSE `data:{...}`
# or newline-delimited JSON: `{"type":"partial"|"final","text":"..."}`; a one-shot `{"text":"..."}`
# is accepted too). The URL is operator-configured (never user-supplied) ⇒ no SSRF surface.
STREAMING_STT_URL=                 # e.g. http://127.0.0.1:8086/dictate  (blank = live dictation dark)

# Web search ("Research") — the premium "search the web" capability. The app retrieves
# live web context BEFORE a turn and injects it, so ANY Jano model answers from fresh,
# cited sources (self-hosted Qwen has no native web search).
# The toggle stays hidden until a provider below is configured. Pick ONE provider:
#   - Tavily : LLM-ready results + page content in one call. Key at https://app.tavily.com
#              (1,000 free searches/mo). Recommended default.
#   - Brave  : independent web index. Key at https://api-dashboard.search.brave.com
#              (~1,000 free queries/mo). App fetches + extracts page text itself.
#   - SearXNG: self-hosted metasearch, no key, no third-party data leakage. Set its URL.
WEB_SEARCH_ENABLED=true            # master switch for the feature
WEB_SEARCH_PROVIDER=auto           # auto | tavily | brave | searxng (auto = first configured)
TAVILY_API_KEY=                    # Tavily key (tvly-...). Leave blank if unused.
BRAVE_SEARCH_API_KEY=              # Brave Search API subscription token. Leave blank if unused.
SEARXNG_URL=                       # self-hosted SearXNG base URL, e.g. http://127.0.0.1:8888
WEB_SEARCH_GUESTS=false            # premium gate: false = admins only; true = guests too (until subscriptions land)
WEB_SEARCH_MAX_RESULTS=6           # sources kept per turn
WEB_SEARCH_MAX_FETCH=4             # pages to fetch+extract when the provider returns snippets only

# Bring-your-own-key (BYOK, #14). Lets an entitled (paid) account plug in its own frontier
# provider API key and run turns on its own key/cost. Keys are stored ENCRYPTED at rest with the
# key below (AES-256-GCM). Leave BYOK_ENCRYPTION_KEY blank to disable BYOK entirely (keys can't be
# stored; the feature stays dark).
# MUST be a STABLE 32-byte hex string (64 hex chars): generate with `openssl rand -hex 32`.
# NEVER rotate it once keys exist — old keys become undecryptable (they fail closed to local).
BYOK_ENCRYPTION_KEY=
BYOK_GUESTS=false                  # premium gate: false = owner only; true = accounts too (until subscriptions land)

# Plans / billing (#13) — the paid ladder (free local taste -> BYOK -> pro flat). ALL OPTIONAL:
# leave blank and billing stays DARK (every premium feature still works via the entitlement plan +
# the *_GUESTS flags above; an account's plan is then set by the admin, not self-serve). To offer
# self-serve upgrades, wire a billing provider (e.g. Polar):
#   BILLING_PROVIDER          — a label like "polar". Non-empty ⇒ the pricing page offers checkout.
#   BILLING_WEBHOOK_SECRET    — HMAC-SHA256 secret the provider (or a thin relay) signs the webhook
#                               body with. UNSET ⇒ the webhook fails closed (no plan can flip).
#   BILLING_CHECKOUT_URL_PLUS  — the provider's HOSTED checkout link for the Plus plan (https only).
#   BILLING_CHECKOUT_URL_PRO   — the provider's HOSTED checkout link for the Pro plan (https only).
#   BILLING_CHECKOUT_URL_ULTRA — the provider's HOSTED checkout link for the Ultra plan (https only).
# The provider POSTs `POST /api/billing/webhook` with `{ "email", "plan" }` signed under the secret
# (header `x-a7t-billing-signature: <hex>`); a valid event flips that account's plan.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
BILLING_CHECKOUT_URL_PLUS=
BILLING_CHECKOUT_URL_PRO=
BILLING_CHECKOUT_URL_ULTRA=

# Attachments / file manager (#15) — per-account uploaded files. Bytes live on local disk today
# (cloud later); FILES_DIR is created under the writable data dir. The three limits are the abuse
# guard, enforced server-side before any byte is written: FILES_MAX_FILE_BYTES caps a single upload
# (keep it UNDER the 30MB global body limit), FILES_MAX_TOTAL_BYTES the per-account footprint, and
# FILES_MAX_COUNT the per-account file count. All optional — the defaults below apply when unset.
FILES_DIR=./data/files
FILES_MAX_FILE_BYTES=26214400      # 25 MiB per file
FILES_MAX_TOTAL_BYTES=209715200    # 200 MiB total per account
FILES_MAX_COUNT=200                # max files per account

# Cloudflare — full-powered token. Copy ONLY these two lines from ~/projects/a7t.ai/.env:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# First-party telemetry (local events table). Set false to disable all collection.
TELEMETRY_ENABLED=true

# Deployment environment label: "staging" on the staging instance (drives the staging
# badge + the staging-only /docs route); unset/"production" on prod.
APP_ENV=production

# Public base URL. Used to derive the expected WebAuthn origin AND to build absolute
# shareable-live-collab watch links (`<APP_URL>/s/<slug>`). Set to the real origin.
APP_URL=https://a7t.chat

# WebAuthn / passkey auth (#20, #169). Passkeys are the ONLY account credential — a visitor signs UP
# by registering a passkey (which creates their account + session; no email, no invite) or signs IN
# with an existing one. The Relying Party ID is the REGISTRABLE DOMAIN the app is served from (host
# only, no scheme, no port) — it MUST match the browser's address bar when a passkey is registered/
# used. Normally the host of APP_URL above (e.g. a7t.chat). The expected browser ORIGIN is derived
# from APP_URL, so keep APP_URL set to the real public origin. UNSET => passkeys are DARK: the sign-up/
# sign-in buttons don't show and no passkey route mints a session, so ONLY the local break-glass
# bootstrap (DEV_ADMIN_LOGIN, see the Auth section) can reach the app — set this to open account sign-up.
WEBAUTHN_RP_ID=
# Per-IP cap on passkey ceremony STARTS in a rolling minute (bounds the challenge table + abuse).
# Loopback is exempt. Optional — defaults to 30.
PASSKEY_RATE_LIMIT_PER_MIN=30

# Shared-page TODO completions (#45). The public watch link is read-only except for ticking a
# TODO checkbox; that one write is gated by a temporary, slug-bound HMAC token.
# SHARE_WRITE_SECRET signs those tokens — set it to keep issued tokens valid across restarts;
# leave it blank and an ephemeral per-boot secret is generated (fine — the page re-fetches a
# fresh token every few seconds). SHARE_WRITE_RATE_LIMIT_PER_MIN caps toggles per token.
SHARE_WRITE_SECRET=
SHARE_WRITE_RATE_LIMIT_PER_MIN=30

# BYOK at-rest encryption (issue #13). Symmetric key used to encrypt user-supplied provider
# API keys before they touch the DB (AES-256-GCM) — 32 random bytes, base64-encoded. Leave
# UNSET to keep BYOK dormant: the feature shows as unavailable and no key is ever persisted in
# plaintext (graceful degradation). Generate: openssl rand -base64 32
BYOK_ENC_KEY=
